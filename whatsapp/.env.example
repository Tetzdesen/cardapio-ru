# Copie para .env e preencha. O .env nao vai para o repositorio.

# Endereco publico do servidor. Sem dominio proprio, o sslip.io resolve o IP
# escrito no nome: para o IP 203.0.113.10, use 203-0-113-10.sslip.io.
WAHA_DOMINIO=203-0-113-10.sslip.io

# Exigida em toda chamada, no cabecalho X-Api-Key. Gere com: openssl rand -hex 32
WAHA_API_KEY=

# Painel (/dashboard) e Swagger, onde se escaneia o QR. Ficam expostos na
# internet: troque as senhas.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

# Reconecta a sessao sozinho quando o conteiner reinicia.
WHATSAPP_RESTART_ALL_SESSIONS=True
